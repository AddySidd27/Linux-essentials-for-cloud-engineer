width="140" height="56" as="geometry"/></mxCell><mxCell id="c13" value="Physical volume&lt;br&gt;pvcreate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;fontColor=#333333;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="500" y="165" width="140" height="56" as="geometry"/></mxCell><mxCell id="c14" value="Physical volume&lt;br&gt;pvcreate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;fontColor=#333333;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="700" y="165" width="140" height="56" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Volume group&lt;/b&gt; datavg (vgcreate)&lt;br&gt;one pool of space" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;fontColor=#333333;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="500" y="255" width="340" height="56" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Logical volume&lt;/b&gt; /dev/datavg/datalv&lt;br&gt;lvcreate, grow with lvextend -r" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontColor=#333333;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="500" y="345" width="340" height="56" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Filesystem + mount&lt;/b&gt; /data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontColor=#333333;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="500" y="435" width="340" height="44" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=2;fontSize=12;fontColor=#333333;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=2;fontSize=12;fontColor=#333333;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=2;fontSize=12;fontColor=#333333;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;entryX=0.206;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=2;fontSize=12;fontColor=#333333;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;entryX=0.794;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=2;fontSize=12;fontColor=#333333;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=2;fontSize=12;fontColor=#333333;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="&lt;b&gt;/etc/fstab makes it permanent&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;UUID=3f1c...&amp;nbsp; /data&amp;nbsp; ext4&amp;nbsp; defaults,nofail&amp;nbsp; 0&amp;nbsp; 2&lt;/font&gt;&lt;br&gt;&amp;bull; Use the UUID (or the LV path), never /dev/sdc: device names can change.&lt;br&gt;&amp;bull; &lt;b&gt;nofail&lt;/b&gt; lets the server boot even if this disk is missing.&lt;br&gt;&amp;bull; Always test before a reboot: &lt;font face=&quot;Courier New&quot;&gt;sudo findmnt --verify &amp;amp;&amp;amp; sudo mount -a&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontColor=#333333;align=left;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="505" width="800" height="110" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Growing later:&lt;/b&gt; resize the disk in the cloud, then &lt;font face=&quot;Courier New&quot;&gt;growpart /dev/sdc 1&lt;/font&gt; and &lt;font face=&quot;Courier New&quot;&gt;resize2fs /dev/sdc1&lt;/font&gt; (ext4) or &lt;font face=&quot;Courier New&quot;&gt;xfs_growfs /data&lt;/font&gt; (xfs). With LVM: &lt;font face=&quot;Courier New&quot;&gt;pvresize&lt;/font&gt; then &lt;font face=&quot;Courier New&quot;&gt;lvextend -r&lt;/font&gt;. Disks can grow but never shrink." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=12;fontColor=#333333;align=left;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="800" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>