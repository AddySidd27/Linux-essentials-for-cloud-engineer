<mxfile host="drawio"><diagram name="Page-1" id="p1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="VM does not come back after a reboot: recovery ladder" style="text;html=1;whiteSpace=wrap;fontSize=18;fontColor=#333333;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="1000" height="30" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;1. Read the boot log&lt;/b&gt; (no login needed)&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;az vm boot-diagnostics get-boot-log&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;aws ec2 get-console-output --latest&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;gcloud compute instances get-serial-port-output&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontColor=#333333;align=left;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="440" height="100" as="geometry"/></mxCell><mxCell id="c3" value="Typical findings:&lt;br&gt;&amp;bull; &lt;b&gt;Failed to mount /data&lt;/b&gt; + emergency mode = bad fstab line&lt;br&gt;&amp;bull; &lt;b&gt;Kernel panic&lt;/b&gt; = bad kernel update&lt;br&gt;&amp;bull; Boot finished but no SSH = network / firewall / sshd" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontColor=#333333;align=left;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="560" y="50" width="440" height="100" as="geometry"/></mxCell><mxCell id="c4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=2;fontSize=12;fontColor=#333333;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c5" value="&lt;b&gt;2. Agent still running?&lt;/b&gt; Fix it with a command&lt;br&gt;Azure Run Command, AWS Session Manager / Run Command" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontColor=#333333;align=left;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="440" height="64" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;3. Interactive serial console&lt;/b&gt;&lt;br&gt;Needs a local user &lt;b&gt;with a password&lt;/b&gt;. For fstab: GRUB &lt;b&gt;e&lt;/b&gt; &amp;rarr; add &lt;font face=&quot;Courier New&quot;&gt;systemd.unit=emergency.target&lt;/font&gt; &amp;rarr; &lt;font face=&quot;Courier New&quot;&gt;mount -o remount,rw /&lt;/font&gt; &amp;rarr; fix &lt;font face=&quot;Courier New&quot;&gt;/etc/fstab&lt;/font&gt; &amp;rarr; reboot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;fontColor=#333333;align=left;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="440" height="100" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;4. Rescue VM&lt;/b&gt; (always works)&lt;br&gt;Attach the broken OS disk to a healthy VM, mount it, edit the files, attach it back.&lt;br&gt;Azure: &lt;font face=&quot;Courier New&quot;&gt;az vm repair create&lt;/font&gt; &amp;nbsp;AWS: rescue instance &amp;nbsp;GCP: rescue VM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;fontColor=#333333;align=left;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="425" width="440" height="90" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;5. Restore the snapshot&lt;/b&gt;&lt;br&gt;Last resort, loses changes since the snapshot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;fontColor=#333333;align=left;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="440" height="56" as="geometry"/></mxCell><mxCell id="c9" value="then" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=2;fontSize=12;fontColor=#333333;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c2" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="agent not running" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=2;fontSize=12;fontColor=#333333;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="no console or no password" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=2;fontSize=12;fontColor=#333333;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="disk damaged" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=2;fontSize=12;fontColor=#333333;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="&lt;b&gt;Prevent it&lt;/b&gt;&lt;br&gt;&amp;bull; fstab: use &lt;b&gt;UUID=&lt;/b&gt; and &lt;b&gt;nofail&lt;/b&gt;, run &lt;font face=&quot;Courier New&quot;&gt;findmnt --verify&lt;/font&gt; and &lt;font face=&quot;Courier New&quot;&gt;mount -a&lt;/font&gt; before rebooting&lt;br&gt;&amp;bull; Snapshot the OS disk before patching or risky changes&lt;br&gt;&amp;bull; Set a password for one console user on important servers&lt;br&gt;&amp;bull; Enable boot diagnostics / serial console when you build the VM&lt;br&gt;&amp;bull; Test SSH and firewall changes from a second session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=12;fontColor=#333333;align=left;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="560" y="190" width="440" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>