<mxfile host="drawio"><diagram name="Page-1" id="p1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="What cloud-init does on the first boot" style="text;html=1;whiteSpace=wrap;fontSize=18;fontColor=#333333;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="960" height="30" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;You&lt;/b&gt;&lt;br&gt;az vm create --custom-data&lt;br&gt;aws ec2 run-instances --user-data&lt;br&gt;gcloud ... --metadata-from-file user-data=" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;fontColor=#333333;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="300" height="86" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Instance metadata service&lt;/b&gt;&lt;br&gt;169.254.169.254&lt;br&gt;hostname, SSH keys, network, your user data, identity tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;fontColor=#333333;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="300" height="86" as="geometry"/></mxCell><mxCell id="c4" value="stored with the VM" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=2;fontSize=12;fontColor=#333333;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c5" value="&lt;b&gt;1.&lt;/b&gt; VM boots, cloud-init detects the cloud" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontColor=#333333;align=left;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="440" y="50" width="360" height="44" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;2.&lt;/b&gt; Reads metadata: hostname, SSH keys, network" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontColor=#333333;align=left;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="440" y="110" width="360" height="44" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1;fontSize=12;fontColor=#333333;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="&lt;b&gt;3.&lt;/b&gt; Reads your user data (#cloud-config)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontColor=#333333;align=left;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="440" y="170" width="360" height="44" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1;fontSize=12;fontColor=#333333;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="&lt;b&gt;4.&lt;/b&gt; Grows root disk, sets hostname, creates users, adds keys" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontColor=#333333;align=left;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="440" y="230" width="360" height="44" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1;fontSize=12;fontColor=#333333;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="&lt;b&gt;5.&lt;/b&gt; packages, write_files, runcmd (as root, once)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontColor=#333333;align=left;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="440" y="290" width="360" height="44" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1;fontSize=12;fontColor=#333333;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="&lt;b&gt;6.&lt;/b&gt; Writes /var/lib/cloud/instance/boot-finished" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontColor=#333333;align=left;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="440" y="350" width="360" height="44" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1;fontSize=12;fontColor=#333333;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;strokeWidth=2;fontSize=12;fontColor=#333333;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;strokeWidth=2;fontSize=12;fontColor=#333333;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="&lt;b&gt;Check it&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;cloud-init status --long&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;/var/log/cloud-init-output.log&lt;/font&gt; (start here)&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;/var/log/cloud-init.log&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;sudo cloud-init query userdata&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontColor=#333333;align=left;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="840" y="50" width="250" height="150" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Remember&lt;/b&gt;&lt;br&gt;&amp;bull; Runs once per instance: rebooting does not run it again&lt;br&gt;&amp;bull; First line must be &lt;font face=&quot;Courier New&quot;&gt;#cloud-config&lt;/font&gt;&lt;br&gt;&amp;bull; Validate first: &lt;font face=&quot;Courier New&quot;&gt;cloud-init schema --config-file file.yaml&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=12;fontColor=#333333;align=left;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="840" y="215" width="250" height="135" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>