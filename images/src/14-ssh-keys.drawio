="170" width="240" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;known_hosts&lt;/b&gt;&lt;br&gt;~/.ssh/known_hosts&lt;br&gt;servers you have trusted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=12;fontColor=#333333;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="260" width="240" height="62" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;authorized_keys&lt;/b&gt;&lt;br&gt;~/.ssh/authorized_keys&lt;br&gt;.ssh = 700, file = 600" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontColor=#333333;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="660" y="80" width="260" height="70" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;sshd&lt;/b&gt; on port 22&lt;br&gt;/etc/ssh/sshd_config(.d)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontColor=#333333;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="660" y="170" width="260" height="70" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Host keys&lt;/b&gt;&lt;br&gt;/etc/ssh/ssh_host_*_key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=12;fontColor=#333333;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="660" y="260" width="260" height="62" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;1.&lt;/b&gt; copied to the server once&lt;br&gt;(cloud portal, ssh-copy-id)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#333333;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;2.&lt;/b&gt; signs a challenge to prove&lt;br&gt;it has 