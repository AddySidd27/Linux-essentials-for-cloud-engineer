/mxCell><mxCell id="c6" value="SSH" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=2;fontSize=12;fontColor=#333333;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;entryX=0;entryY=0.83;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="Linux VM (Ubuntu 24.04 or Rocky 9)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=14;fontColor=#333333;align=center;verticalAlign=middle;arcSize=8;spacing=6;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="45" width="440" height="380" as="geometry"/></mxCell><mxCell id="c8" value="Host firewall (ufw / firewalld), fail2ban, key-only SSH, AppArmor / SELinux enforcing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontColor=#333333;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="420" y="80" width="400" height="44" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;nginx&lt;/b&gt; :80 / :443&lt;br&gt;reverse proxy, Let's Encrypt TLS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontColor=#333333;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="420" y="140" width="180" height="66" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;myapp&lt;/b&gt; 127.0.0.1:8080&lt;br&gt;systemd service, user myapp&lt;br&gt;Restart=on-failure, MemoryMax" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontColor=#333333;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="640" y="140" width="180" height="66" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strok