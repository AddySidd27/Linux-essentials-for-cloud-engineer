;br&gt;managed identity / IAM role / service account, no keys on disk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontColor=#333333;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="880" y="120" width="160" height="90" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Cloud storage&lt;/b&gt;&lt;br&gt;Blob / S3 / Cloud Storage&lt;br&gt;14 days of backups" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;fontColor=#333333;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="880" y="300" width="160" height="76" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Cloud monitoring&lt;/b&gt;&lt;br&gt;Azure Monitor / CloudWatch / Cloud Monitoring&lt;br&gt;alert: disk &amp;gt; 85%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;fontColor=#333333;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="880" y="405" width="160" height="80" as="geometry"/></mxCell><mxCell id="c19" value="backup" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=2;fontSize=12;fontColor=#333333;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.62;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="metrics, logs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=2;fontSize=12;fontColor=#333333;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="authorises" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673A6;strokeWidth=2;fontSize=12;fontColor=#333333;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="&lt;b&gt;Break and fix&lt;/b&gt; (10 exercises): 502 from nginx, permission denied, full disk, deleted file still open, firewall lockout, bad fstab line, broken sudoers, OOM kill, SELinux label, bad DNS. For each one write symptom, cause, fix." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;fontColor=#333333;align=left;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="500" width="1020" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>