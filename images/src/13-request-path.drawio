<mxfile host="drawio"><diagram name="Page-1" id="p1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="The path of a request to a cloud VM, and how to test each layer" style="text;html=1;whiteSpace=wrap;fontSize=18;fontColor=#333333;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="900" height="30" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Layer&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="420" height="24" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Test it with&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="520" y="40" width="380" height="24" as="geometry"/></mxCell><mxCell id="c4" value="Client (your laptop or another server)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;fontColor=#333333;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="420" height="62" as="geometry"/></mxCell><mxCell id="c5" value="curl -v http://PUBLIC_IP/&lt;br&gt;nc -zv -w 3 PUBLIC_IP 22" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=12;fontColor=#333333;align=left;verticalAlign=middle;arcSize=8;spacing=6;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="520" y="70" width="400" height="62" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#AAAAAA;strokeWidth=1;fontSize=12;fontColor=#333333;endArrow=none;endFill=1;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="Internet / VPN / peered network" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;fontColor=#333333;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="162" width="420" height="62" as="geometry"/></mxCell><mxCell id="c8" value="mtr -rwc 10 PUBLIC_IP&lt;br&gt;(ping is often blocked)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=12;fontColor=#333333;align=left;verticalAlign=middle;arcSize=8;spacing=6;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="520" y="162" width="400" height="62" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#AAAAAA;strokeWidth=1;fontSize=12;fontColor=#333333;endArrow=none;endFill=1;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="&lt;b&gt;Cloud network rules&lt;/b&gt;&lt;br&gt;Azure NSG, AWS security group + NACL, GCP firewall rule" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;fontColor=#333333;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="254" width="420" height="62" as="geometry"/></mxCell><mxCell id="c11" value="Effective rules in the portal / CLI&lt;br&gt;az network nic list-effective-nsg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=12;fontColor=#333333;align=left;verticalAlign=middle;arcSize=8;spacing=6;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="520" y="254" width="400" height="62" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#AAAAAA;strokeWidth=1;fontSize=12;fontColor=#333333;endArrow=none;endFill=1;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="&lt;b&gt;VM network card&lt;/b&gt;&lt;br&gt;eth0 / ens5, private IP only (public IP is NAT)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;fontColor=#333333;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="346" width="420" height="62" as="geometry"/></mxCell><mxCell id="c14" value="ip -brief address&lt;br&gt;ip route" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=12;fontColor=#333333;align=left;verticalAlign=middle;arcSize=8;spacing=6;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="520" y="346" width="400" height="62" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#AAAAAA;strokeWidth=1;fontSize=12;fontColor=#333333;endArrow=none;endFill=1;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="&lt;b&gt;Linux host firewall&lt;/b&gt;&lt;br&gt;ufw (Ubuntu) or firewalld (Red Hat family)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontColor=#333333;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="438" width="420" height="62" as="geometry"/></mxCell><mxCell id="c17" value="sudo ufw status verbose&lt;br&gt;sudo firewall-cmd --list-all" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=12;fontColor=#333333;align=left;verticalAlign=middle;arcSize=8;spacing=6;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="520" y="438" width="400" height="62" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#AAAAAA;strokeWidth=1;fontSize=12;fontColor=#333333;endArrow=none;endFill=1;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="&lt;b&gt;Process listening on the port&lt;/b&gt;&lt;br&gt;nginx :80, sshd :22 (0.0.0.0 or 127.0.0.1?)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontColor=#333333;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="420" height="62" as="geometry"/></mxCell><mxCell id="c20" value="sudo ss -ltnp&lt;br&gt;curl -sI http://localhost/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=12;fontColor=#333333;align=left;verticalAlign=middle;arcSize=8;spacing=6;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="520" y="530" width="400" height="62" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#AAAAAA;strokeWidth=1;fontSize=12;fontColor=#333333;endArrow=none;endFill=1;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=2;fontSize=12;fontColor=#333333;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=2;fontSize=12;fontColor=#333333;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=2;fontSize=12;fontColor=#333333;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c10" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=2;fontSize=12;fontColor=#333333;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c13" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=2;fontSize=12;fontColor=#333333;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c16" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="&lt;b&gt;Troubleshoot from the inside out:&lt;/b&gt; prove the process listens, then the host firewall, then the cloud rules. &lt;b&gt;tcpdump&lt;/b&gt; on the VM tells you whether packets arrive at all:&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;sudo tcpdump -ni any port 80 -c 5&lt;/font&gt; &amp;nbsp;&amp;nbsp;nothing seen = blocked before the VM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontColor=#333333;align=left;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="626" width="880" height="62" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>