<mxfile host="drawio"><diagram name="Page-1" id="p1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Chapter 19 lab on Azure: what the commands build" style="text;html=1;whiteSpace=wrap;fontSize=18;fontColor=#333333;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="1000" height="30" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Your laptop&lt;/b&gt;&lt;br&gt;SSH key, Azure CLI&lt;br&gt;your public IP = MYIP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;fontColor=#333333;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="212" width="150" height="84" as="geometry"/></mxCell><mxCell id="c3" value="Resource group: lab-rg (eastus)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=14;fontColor=#333333;align=center;verticalAlign=middle;arcSize=8;spacing=6;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="45" width="820" height="520" as="geometry"/></mxCell><mxCell id="c4" value="Virtual network web01VNET 10.0.0.0/16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=14;fontColor=#333333;align=center;verticalAlign=middle;arcSize=8;spacing=6;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="80" width="570" height="470" as="geometry"/></mxCell><mxCell id="c5" value="Subnet web01Subnet 10.0.0.0/24" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=14;fontColor=#333333;align=center;verticalAlign=middle;arcSize=8;spacing=6;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="115" width="530" height="420" as="geometry"/></mxCell><mxCell id="c6" value="Public IP&lt;br&gt;(Standard, static)" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Public_IP_Addresses.svg;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="280" y="230" width="60" height="48" as="geometry"/></mxCell><mxCell id="c7" value="NIC&lt;br&gt;private IP 10.0.0.4" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Network_Interfaces.svg;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="228" width="60" height="52" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;VM web01&lt;/b&gt;&lt;br&gt;Ubuntu 24.04, Standard_B2s" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/Virtual_Machine.svg;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="610" y="222" width="69" height="64" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;NSG web01NSG&lt;/b&gt;&lt;br&gt;allow 22 from MYIP/32&lt;br&gt;allow 80 from Internet&lt;br&gt;deny everything else" style="image;aspect=fixed;html=1;points=[];labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;image=img/lib/azure2/networking/Network_Security_Groups.svg;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="476" y="145" width="48" height="58" as="geometry"/></mxCell><mxCell id="c10" value="ssh azureuser@IP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0078D4;strokeWidth=2;fontSize=12;fontColor=#333333;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c2" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxC