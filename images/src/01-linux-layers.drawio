<mxfile host="drawio"><diagram name="Page-1" id="p1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="How a Linux server is built" style="text;html=1;whiteSpace=wrap;fontSize=18;fontColor=#333333;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="760" height="30" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Your applications&lt;/b&gt;&lt;br&gt;nginx, databases, your app (myapp), cloud agents" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontColor=#333333;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="120" y="50" width="560" height="56" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;User-space tools and shell&lt;/b&gt;&lt;br&gt;bash, ls, grep, ssh, apt / dnf, systemctl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;fontColor=#333333;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="120" y="116" width="560" height="56" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;systemd (PID 1)&lt;/b&gt;&lt;br&gt;starts, stops and watches every service; journald keeps the logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontColor=#333333;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="120" y="182" width="560" height="56" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Linux kernel&lt;/b&gt;&lt;br&gt;processes, memory, filesystems, network, drivers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;fontColor=#333333;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="120" y="248" width="560" height="56" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Virtual hardware from the cloud&lt;/b&gt;&lt;br&gt;vCPU, RAM, disks (sda / nvme0n1), network card (eth0 / ens5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;fontColor=#333333;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="120" y="314" width="560" height="56" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Distribution&lt;/b&gt;&lt;br&gt;(Ubuntu, RHEL, Rocky, Amazon Linux)&lt;br&gt;&lt;br&gt;= kernel + tools + package manager + defaults + support lifecycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontColor=#333333;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="700" y="116" width="190" height="188" as="geometry"/></mxCell><mxCell id="c8" value="You work here" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#6C8EBF;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="10" y="116" width="100" height="56" as="geometry"/></mxCell><mxCell id="c9" value="The kernel talks to hardware so programs do not have to" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#D79B00;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="10" y="248" width="108" height="56" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>