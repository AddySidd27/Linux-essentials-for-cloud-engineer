<mxfile host="drawio"><diagram name="Page-1" id="p1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Chapter 21 lab on Google Cloud: what the commands build" style="text;html=1;whiteSpace=wrap;fontSize=18;fontColor=#333333;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="1000" height="30" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Your laptop&lt;/b&gt;&lt;br&gt;gcloud CLI, SSH key&lt;br&gt;your public IP = MYIP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;fontColor=#333333;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="223" width="150" height="84" as="geometry"/></mxCell><mxCell id="c3" value="Project my-project-id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=14;fontColor=#333333;align=center;verticalAlign=middle;arcSize=8;spacing=6;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="45" width="820" height="520" as="geometry"/></mxCell><mxCell id="c4" value="VPC network &quot;default&quot; (global)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=14;fontColor=#333333;align=center;verticalAlign=middle;arcSize=8;spacing=6;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="80" width="580" height="470" as="geometry"/></mxCell><mxCell id="c5" value="Zone us-central1-a" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=14;fontColor=#333333;align=center;verticalAlign=middle;arcSize=8;spacing=6;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="195" width="360" height="340" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Firewall rules&lt;/b&gt; (apply by network tag lab-web)&lt;br&gt;lab-allow-ssh-my-ip: tcp:22 from MYIP/32&lt;br&gt;lab-allow-http: tcp:80 from 0.0.0.0/0&lt;br&gt;lab-allow-iap-ssh: tcp:22 from 35.235.240.0/20" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;arcSize=8;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="240" y="115" width="540" height="66" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;VM web01&lt;/b&gt; (tag: lab-web)&lt;br&gt;Ubuntu 24.04, e2-small&lt;br&gt;service account web01-sa" style="sketch=0;html=1;fillColor=#5184F3;strokeColor=none;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;spacingTop=-6;outlineConnect=0;shape=mxgraph.gcp2.hexIcon;prIcon=compute_engine;;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="545" y="225" width="90" height="80" as="geometry"/></mxCell><mxCell id="c8" value="ssh / gcloud compute ssh" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4285F4;strokeWidth=2;fontSize=12;fontColor=#333333;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c2" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#333333;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="Boot disk 20 GB&lt;br&gt;/dev/sda" style="sketch=0;html=1;fillColor=#5184F3;strokeColor=none;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;spacingTop=-6;outlineConnect=0;shape=mxgraph.gcp2.hexIcon;prIcon=persistent_disk;;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="420" width="70" height="62" as="geometry"/></mxCell><mxCell id="c11" value="Data disk web01-data&lt;br&gt;/dev/disk/by-id/google-web01-data" style="sketch=0;html=1;fillColor=#5184F3;strokeColor=none;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;spacingTop=-6;outlineConnect=0;shape=mxgraph.gcp2.hexIcon;prIcon=persistent_disk;;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="630" y="420" width="70" height="62" as="geometry"/></mxCell><mxCell id="c12" value="Rules match VMs by &lt;b&gt;network tag&lt;/b&gt;. A VM without the tag gets none of these rules." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="240" y="380" width="160" height="110" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Identity-Aware Proxy&lt;/b&gt;&lt;br&gt;SSH without a public IP:&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;gcloud compute ssh web01 --tunnel-through-iap&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="820" y="110" width="190" height="110" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;OS Login&lt;/b&gt;&lt;br&gt;Linux access through IAM roles:&lt;br&gt;roles/compute.osLogin&lt;br&gt;roles/compute.osAdminLogin (sudo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="820" y="260" width="190" height="90" as="geometry"/></mxCell><mxCell id="c15" value="&